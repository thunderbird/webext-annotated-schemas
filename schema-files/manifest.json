[
    {
        "applicationVersion": "142.0b4",
        "namespace": "manifest",
        "permissions": [],
        "types": [
            {
                "id": "ManifestBase",
                "properties": {
                    "author": {
                        "onError": "warn",
                        "optional": true,
                        "preprocess": "localize",
                        "type": "string"
                    },
                    "browser_specific_settings": {
                        "$ref": "BrowserSpecificSettings",
                        "optional": true
                    },
                    "developer": {
                        "optional": true,
                        "properties": {
                            "name": {
                                "optional": true,
                                "preprocess": "localize",
                                "type": "string"
                            },
                            "url": {
                                "format": "url",
                                "onError": "warn",
                                "optional": true,
                                "preprocess": "localize",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    "homepage_url": {
                        "format": "url",
                        "optional": true,
                        "preprocess": "localize",
                        "type": "string"
                    },
                    "install_origins": {
                        "items": {
                            "format": "origin",
                            "type": "string"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "manifest_version": {
                        "maximum": 3,
                        "minimum": 2,
                        "postprocess": "manifestVersionCheck",
                        "type": "integer"
                    },
                    "name": {
                        "optional": false,
                        "preprocess": "localize",
                        "type": "string"
                    },
                    "short_name": {
                        "optional": true,
                        "preprocess": "localize",
                        "type": "string"
                    },
                    "version": {
                        "format": "versionString",
                        "optional": false,
                        "type": "string"
                    }
                },
                "type": "object"
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "id": "WebExtensionManifest",
                "properties": {
                    "background": {
                        "additionalProperties": {
                            "$ref": "UnrecognizedProperty"
                        },
                        "optional": true,
                        "postprocess": "checkRequiredManifestBackgroundKeys",
                        "properties": {
                            "page": {
                                "$ref": "ExtensionURL",
                                "optional": true
                            },
                            "preferred_environment": {
                                "items": {
                                    "enum": [
                                        "service_worker",
                                        "document"
                                    ],
                                    "onError": "warn",
                                    "type": "string"
                                },
                                "optional": true,
                                "type": "array"
                            },
                            "scripts": {
                                "items": {
                                    "$ref": "ExtensionURL"
                                },
                                "optional": true,
                                "type": "array"
                            },
                            "service_worker": {
                                "$ref": "ExtensionURL",
                                "optional": true
                            },
                            "type": {
                                "enum": [
                                    "module",
                                    "classic"
                                ],
                                "optional": true,
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    "content_scripts": {
                        "items": {
                            "$ref": "ContentScript"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "content_security_policy": {
                        "additionalProperties": {
                            "$ref": "UnrecognizedProperty"
                        },
                        "onError": "warn",
                        "optional": true,
                        "properties": {
                            "extension_pages": {
                                "format": "contentSecurityPolicy",
                                "optional": true,
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    "granted_host_permissions": {
                        "default": false,
                        "optional": true,
                        "type": "boolean"
                    },
                    "hidden": {
                        "default": false,
                        "optional": true,
                        "type": "boolean"
                    },
                    "host_permissions": {
                        "default": [],
                        "items": {
                            "$ref": "MatchPattern",
                            "onError": "warn"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "icons": {
                        "optional": true,
                        "patternProperties": {
                            "^[1-9]\\d*$": {
                                "$ref": "ExtensionFileUrl"
                            }
                        },
                        "type": "object"
                    },
                    "incognito": {
                        "default": "spanning",
                        "enum": [
                            "not_allowed",
                            "spanning",
                            "split"
                        ],
                        "optional": true,
                        "postprocess": "incognitoSplitUnsupportedAndFallback",
                        "type": "string"
                    },
                    "minimum_chrome_version": {
                        "optional": true,
                        "type": "string"
                    },
                    "minimum_opera_version": {
                        "optional": true,
                        "type": "string"
                    },
                    "optional_host_permissions": {
                        "default": [],
                        "items": {
                            "$ref": "MatchPattern",
                            "onError": "warn"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "optional_permissions": {
                        "default": [],
                        "items": {
                            "$ref": "OptionalPermissionOrOrigin",
                            "onError": "warn"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "options_page": {
                        "$ref": "ExtensionURL",
                        "optional": true
                    },
                    "options_ui": {
                        "additionalProperties": {
                            "$ref": "UnrecognizedProperty"
                        },
                        "optional": true,
                        "properties": {
                            "browser_style": {
                                "optional": true,
                                "type": "boolean"
                            },
                            "open_in_tab": {
                                "optional": true,
                                "type": "boolean"
                            },
                            "page": {
                                "$ref": "ExtensionURL"
                            }
                        },
                        "type": "object"
                    },
                    "permissions": {
                        "default": [],
                        "items": {
                            "$ref": "Permission",
                            "onError": "warn"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "web_accessible_resources": {
                        "items": {
                            "additionalProperties": {
                                "$ref": "UnrecognizedProperty"
                            },
                            "properties": {
                                "extension_ids": {
                                    "items": {
                                        "choices": [
                                            {
                                                "$ref": "ExtensionID"
                                            },
                                            {
                                                "enum": [
                                                    "*"
                                                ],
                                                "type": "string"
                                            }
                                        ]
                                    },
                                    "optional": true,
                                    "type": "array"
                                },
                                "matches": {
                                    "items": {
                                        "$ref": "MatchPattern"
                                    },
                                    "optional": true,
                                    "type": "array"
                                },
                                "resources": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                }
                            },
                            "type": "object"
                        },
                        "optional": true,
                        "postprocess": "webAccessibleMatching",
                        "type": "array"
                    }
                },
                "type": "object"
            },
            {
                "id": "WebExtensionLangpackManifest",
                "properties": {
                    "langpack_id": {
                        "pattern": "^[a-zA-Z][a-zA-Z-]+$",
                        "type": "string"
                    },
                    "languages": {
                        "patternProperties": {
                            "^[a-z]{2}[a-zA-Z-]*$": {
                                "properties": {
                                    "chrome_resources": {
                                        "patternProperties": {
                                            "^[a-zA-Z-.]+$": {
                                                "choices": [
                                                    {
                                                        "$ref": "ExtensionURL"
                                                    },
                                                    {
                                                        "patternProperties": {
                                                            "^[a-z]+$": {
                                                                "$ref": "ExtensionURL"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                ]
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "version": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        },
                        "type": "object"
                    },
                    "sources": {
                        "optional": true,
                        "patternProperties": {
                            "^[a-z]+$": {
                                "properties": {
                                    "base_path": {
                                        "$ref": "ExtensionURL"
                                    },
                                    "paths": {
                                        "items": {
                                            "format": "strictRelativeUrl",
                                            "type": "string"
                                        },
                                        "optional": true,
                                        "type": "array"
                                    }
                                },
                                "type": "object"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            {
                "id": "WebExtensionDictionaryManifest",
                "properties": {
                    "dictionaries": {
                        "patternProperties": {
                            "^[a-z]{2}[a-zA-Z-]*$": {
                                "format": "strictRelativeUrl",
                                "pattern": "\\.dic$",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "annotations": [
                    {
                        "text": "Define a set of icons for themes depending on whether Thunderbird detects that the theme uses dark or light text. All provided URLs must be relative to the <var>manifest.json</var> file."
                    }
                ],
                "id": "ThemeIcons",
                "properties": {
                    "dark": {
                        "$ref": "ExtensionURL"
                    },
                    "light": {
                        "$ref": "ExtensionURL"
                    },
                    "size": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            {
                "enum": [],
                "id": "OptionalOnlyPermission",
                "type": "string"
            },
            {
                "enum": [
                    "idle"
                ],
                "id": "OptionalPermissionNoPrompt",
                "type": "string"
            },
            {
                "choices": [
                    {
                        "$ref": "OptionalPermissionNoPrompt"
                    },
                    {
                        "enum": [
                            "clipboardRead",
                            "clipboardWrite",
                            "geolocation",
                            "notifications"
                        ],
                        "type": "string"
                    }
                ],
                "id": "OptionalPermission"
            },
            {
                "choices": [
                    {
                        "$ref": "OptionalPermission"
                    },
                    {
                        "$ref": "OptionalOnlyPermission"
                    },
                    {
                        "$ref": "MatchPattern"
                    }
                ],
                "id": "OptionalPermissionOrOrigin"
            },
            {
                "enum": [
                    "mozillaAddons"
                ],
                "id": "PermissionPrivileged",
                "type": "string"
            },
            {
                "enum": [
                    "authenticationInfo",
                    "bookmarksInfo",
                    "browsingActivity",
                    "financialAndPaymentInfo",
                    "healthInfo",
                    "locationInfo",
                    "personalCommunications",
                    "personallyIdentifyingInfo",
                    "searchTerms",
                    "websiteActivity",
                    "websiteContent"
                ],
                "id": "CommonDataCollectionPermission",
                "type": "string"
            },
            {
                "choices": [
                    {
                        "$ref": "CommonDataCollectionPermission"
                    },
                    {
                        "enum": [
                            "none"
                        ],
                        "type": "string"
                    }
                ],
                "id": "DataCollectionPermission"
            },
            {
                "choices": [
                    {
                        "$ref": "CommonDataCollectionPermission"
                    },
                    {
                        "enum": [
                            "technicalAndInteraction"
                        ],
                        "type": "string"
                    }
                ],
                "id": "OptionalDataCollectionPermission"
            },
            {
                "choices": [
                    {
                        "$ref": "OptionalPermissionNoPrompt"
                    },
                    {
                        "$ref": "PermissionPrivileged"
                    },
                    {
                        "enum": [
                            "alarms",
                            "storage",
                            "unlimitedStorage"
                        ],
                        "type": "string"
                    }
                ],
                "id": "PermissionNoPrompt"
            },
            {
                "choices": [
                    {
                        "$ref": "PermissionNoPrompt"
                    },
                    {
                        "$ref": "OptionalPermission"
                    }
                ],
                "id": "Permission"
            },
            {
                "choices": [
                    {
                        "$ref": "Permission"
                    },
                    {
                        "$ref": "MatchPattern"
                    }
                ],
                "id": "PermissionOrOrigin"
            },
            {
                "format": "url",
                "id": "HttpURL",
                "pattern": "^https?://.*$",
                "type": "string"
            },
            {
                "annotations": [
                    {
                        "text": "A path relative to the root of the extension."
                    }
                ],
                "format": "strictRelativeUrl",
                "id": "ExtensionURL",
                "type": "string"
            },
            {
                "format": "strictRelativeUrl",
                "id": "ExtensionFileUrl",
                "pattern": "\\S",
                "preprocess": "localize",
                "type": "string"
            },
            {
                "annotations": [
                    {
                        "text": "Defines an image resource. Either a image URL relative the the extensions <var>manifest.json</var> file (supported image formats are <var>JPEG</var>, <var>PNG</var>, <var>APNG</var>, <var>SVG</var> and <var>GIF</var>), or a data URL using a base64 encoded representation of a <var>PNG</var> or <var>JPEG</var> image."
                    },
                    {
                        "text": "Example for a base64 encoded <var>PNG</var> image:"
                    },
                    {
                        "code": [
                            "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUAAAAFCAYAAACNbyblAAAAHElEQVQI12P4//8/w38GIAXDIBKE0DHxgljNBAAO9TXL0Y4OHwAAAABJRU5ErkJggg=="
                        ]
                    }
                ],
                "format": "imageDataOrStrictRelativeUrl",
                "id": "ImageDataOrExtensionURL",
                "type": "string"
            },
            {
                "choices": [
                    {
                        "pattern": "(?i)^\\{[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\}$",
                        "type": "string"
                    },
                    {
                        "pattern": "(?i)^[a-z0-9-._]*@[a-z0-9-._]+$",
                        "type": "string"
                    }
                ],
                "id": "ExtensionID"
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "id": "FirefoxSpecificProperties",
                "properties": {
                    "admin_install_only": {
                        "optional": true,
                        "type": "boolean"
                    },
                    "data_collection_permissions": {
                        "optional": true,
                        "properties": {
                            "has_previous_consent": {
                                "default": false,
                                "optional": true,
                                "type": "boolean"
                            },
                            "optional": {
                                "default": [],
                                "items": {
                                    "$ref": "OptionalDataCollectionPermission",
                                    "onError": "warn"
                                },
                                "optional": true,
                                "type": "array"
                            },
                            "required": {
                                "default": [],
                                "items": {
                                    "$ref": "DataCollectionPermission",
                                    "onError": "warn"
                                },
                                "optional": true,
                                "postprocess": "checkValidRequiredDataCollection",
                                "type": "array"
                            }
                        },
                        "type": "object"
                    },
                    "id": {
                        "$ref": "ExtensionID",
                        "optional": true
                    },
                    "strict_max_version": {
                        "optional": true,
                        "type": "string"
                    },
                    "strict_min_version": {
                        "optional": true,
                        "type": "string"
                    },
                    "update_url": {
                        "format": "url",
                        "optional": true,
                        "type": "string"
                    }
                },
                "type": "object"
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "id": "GeckoAndroidSpecificProperties",
                "properties": {
                    "strict_max_version": {
                        "optional": true,
                        "type": "string"
                    },
                    "strict_min_version": {
                        "optional": true,
                        "type": "string"
                    }
                },
                "type": "object"
            },
            {
                "additionalProperties": {
                    "type": "any"
                },
                "id": "DeprecatedApplications",
                "properties": {
                    "gecko": {
                        "$ref": "FirefoxSpecificProperties",
                        "optional": true
                    },
                    "gecko_android": {
                        "$ref": "GeckoAndroidSpecificProperties",
                        "optional": true,
                        "unsupported": true
                    }
                },
                "type": "object"
            },
            {
                "additionalProperties": {
                    "type": "any"
                },
                "id": "BrowserSpecificSettings",
                "properties": {
                    "gecko": {
                        "$ref": "FirefoxSpecificProperties",
                        "optional": true
                    },
                    "gecko_android": {
                        "$ref": "GeckoAndroidSpecificProperties",
                        "optional": true
                    }
                },
                "type": "object"
            },
            {
                "choices": [
                    {
                        "enum": [
                            "<all_urls>"
                        ],
                        "type": "string"
                    },
                    {
                        "$ref": "MatchPatternRestricted"
                    },
                    {
                        "$ref": "MatchPatternUnestricted"
                    }
                ],
                "id": "MatchPattern"
            },
            {
                "choices": [
                    {
                        "pattern": "^(https?|wss?|file|ftp|\\*)://(\\*|\\*\\.[^*/]+|[^*/]+)/.*$",
                        "type": "string"
                    },
                    {
                        "pattern": "^file:///.*$",
                        "type": "string"
                    }
                ],
                "id": "MatchPatternRestricted"
            },
            {
                "id": "MatchPatternUnestricted",
                "pattern": "^resource://(\\*|\\*\\.[^*/]+|[^*/]+)/.*$|^about:",
                "type": "string"
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "id": "ContentScript",
                "properties": {
                    "all_frames": {
                        "optional": true,
                        "type": "boolean"
                    },
                    "css": {
                        "items": {
                            "$ref": "ExtensionURL"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "exclude_globs": {
                        "items": {
                            "type": "string"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "exclude_matches": {
                        "items": {
                            "$ref": "MatchPattern"
                        },
                        "minItems": 1,
                        "optional": true,
                        "type": "array"
                    },
                    "include_globs": {
                        "items": {
                            "type": "string"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "js": {
                        "items": {
                            "$ref": "ExtensionURL"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "match_about_blank": {
                        "optional": true,
                        "type": "boolean"
                    },
                    "match_origin_as_fallback": {
                        "optional": true,
                        "type": "boolean"
                    },
                    "matches": {
                        "items": {
                            "$ref": "MatchPattern"
                        },
                        "minItems": 1,
                        "optional": false,
                        "type": "array"
                    },
                    "run_at": {
                        "$ref": "extensionTypes.RunAt",
                        "default": "document_idle",
                        "optional": true
                    },
                    "world": {
                        "$ref": "extensionTypes.ExecutionWorld",
                        "default": "ISOLATED",
                        "optional": true
                    }
                },
                "type": "object"
            },
            {
                "annotations": [
                    {
                        "text": "Either a <em>string</em> to specify a relative path of a single icon to be used for all sizes, or a <em>dictionary object</em> to specify paths for multiple icons in different sizes, so the icon does not have to be scaled for a device with a different pixel density. Each entry is a <em>name-value</em> pair with <em>value</em> being a relative path to an icon file, and <em>name</em> its size. Example:"
                    },
                    {
                        "code": [
                            "{",
                            "  \"16\": \"icon16.png\",",
                            "  \"32\": \"icon32.png\"",
                            "}",
                            ""
                        ],
                        "type": "JSON"
                    },
                    {
                        "text": "See the $(url:mdn-icon-size)[MDN documentation about choosing icon sizes] for more information on this topic."
                    }
                ],
                "choices": [
                    {
                        "additionalProperties": false,
                        "patternProperties": {
                            "^[1-9]\\d*$": {
                                "$ref": "ExtensionFileUrl"
                            }
                        },
                        "type": "object"
                    },
                    {
                        "$ref": "ExtensionFileUrl"
                    }
                ],
                "id": "IconPath"
            },
            {
                "choices": [
                    {
                        "additionalProperties": false,
                        "patternProperties": {
                            "^[1-9]\\d*$": {
                                "$ref": "ImageData"
                            }
                        },
                        "type": "object"
                    },
                    {
                        "$ref": "ImageData"
                    }
                ],
                "id": "IconImageData"
            },
            {
                "id": "ImageData",
                "isInstanceOf": "ImageData",
                "postprocess": "convertImageDataToURL",
                "type": "object"
            },
            {
                "id": "UnrecognizedProperty",
                "type": "any"
            }
        ]
    }
]