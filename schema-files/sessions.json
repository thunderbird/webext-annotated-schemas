[
    {
        "applicationVersion": "140.0b2",
        "namespace": "manifest",
        "types": [
            {
                "$extend": "OptionalPermission",
                "choices": [
                    {
                        "enum": [
                            "sessions"
                        ],
                        "type": "string"
                    }
                ]
            }
        ]
    },
    {
        "annotations": [
            {
                "text": "Thunderbird's sessions API is similar to the $(url:mdn-sessions-api)[Firefox sessions API], but it doesn't support accessing or restoring closed tabs."
            },
            {
                "note": "The Sessions API currently does not require the <permission>sessions</permission> permission, but it will soon. It's recommended to request this permission before it becomes mandatory, to ensure your add-on continues to function properly."
            }
        ],
        "description": "The sessions API allows to add tab related session data to Thunderbird's tabs, which will be restored on app restart.",
        "functions": [
            {
                "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/sessions.html#settabvalue-tabid-key-value",
                "async": true,
                "description": "Store a key/value pair associated with a given tab.",
                "mdn_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/sessions/setTabValue",
                "name": "setTabValue",
                "parameters": [
                    {
                        "description": "ID of the tab with which you want to associate the data. Error is thrown if ID is invalid.",
                        "name": "tabId",
                        "support": {
                            "version_added": true
                        },
                        "type": "integer"
                    },
                    {
                        "description": "Key that you can later use to retrieve this particular data value.",
                        "name": "key",
                        "support": {
                            "version_added": true
                        },
                        "type": "string"
                    },
                    {
                        "name": "value",
                        "support": {
                            "version_added": true
                        },
                        "type": "string"
                    }
                ],
                "support": {
                    "version_added": "57"
                },
                "type": "function"
            },
            {
                "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/sessions.html#gettabvalue-tabid-key",
                "async": "callback",
                "description": "Retrieve a previously stored value for a given tab, given its key. Returns <var>undefined</var> if the requested <var>key</var> does not exist for the given <var>tabId</var>.",
                "mdn_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/sessions/getTabValue",
                "name": "getTabValue",
                "parameters": [
                    {
                        "description": "ID of the tab whose data you are trying to retrieve. Error is thrown if ID is invalid.",
                        "name": "tabId",
                        "support": {
                            "version_added": true
                        },
                        "type": "integer"
                    },
                    {
                        "description": "Key identifying the particular value to retrieve.",
                        "name": "key",
                        "support": {
                            "version_added": true
                        },
                        "type": "string"
                    },
                    {
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "optional": true,
                                "type": "string"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "support": {
                    "version_added": "57"
                },
                "type": "function"
            },
            {
                "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/sessions.html#removetabvalue-tabid-key",
                "async": true,
                "description": "Remove a key/value pair from a given tab.",
                "mdn_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/sessions/removeTabValue",
                "name": "removeTabValue",
                "parameters": [
                    {
                        "description": "ID of the tab whose data you are trying to remove. Error is thrown if ID is invalid.",
                        "name": "tabId",
                        "support": {
                            "version_added": true
                        },
                        "type": "integer"
                    },
                    {
                        "description": "Key identifying the particular value to remove.",
                        "name": "key",
                        "support": {
                            "version_added": true
                        },
                        "type": "string"
                    }
                ],
                "support": {
                    "version_added": "57"
                },
                "type": "function"
            }
        ],
        "namespace": "sessions"
    }
]