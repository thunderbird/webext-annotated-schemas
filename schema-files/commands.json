[
    {
        "applicationVersion": "143.0b4",
        "namespace": "manifest",
        "types": [
            {
                "annotations": [
                    {
                        "version_added": "66"
                    }
                ],
                "format": "manifestShortcutKey",
                "id": "KeyName",
                "type": "string"
            },
            {
                "$extend": "WebExtensionManifest",
                "properties": {
                    "commands": {
                        "additionalProperties": {
                            "$ref": "CommandsShortcut"
                        },
                        "annotations": [
                            {
                                "text": "The <em>name</em> may also be one of the following built-in special shortcuts:"
                            },
                            {
                                "list": [
                                    "<var>_execute_browser_action</var>",
                                    "<var>_execute_compose_action</var>",
                                    "<var>_execute_message_display_action</var>"
                                ]
                            },
                            {
                                "text": "Example:"
                            },
                            {
                                "code": [
                                    "{",
                                    "  \"commands\": {",
                                    "    \"toggle-feature\": {",
                                    "      \"suggested_key\": {",
                                    "        \"default\": \"Ctrl+Shift+Y\",",
                                    "        \"linux\": \"Ctrl+Shift+U\"",
                                    "      },",
                                    "      \"description\": \"Send a 'toggle-feature' event\"",
                                    "    },",
                                    "    \"_execute_compose_action\": {",
                                    "      \"suggested_key\": {",
                                    "        \"default\": \"Alt+F5\"",
                                    "      },",
                                    "      \"description\": \"Open the compose action popup\"",
                                    "    }",
                                    "  }",
                                    "}",
                                    ""
                                ],
                                "type": "JSON"
                            },
                            {
                                "version_added": "66"
                            }
                        ],
                        "optional": true,
                        "type": "object"
                    }
                }
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "annotations": [
                    {
                        "version_added": "140"
                    }
                ],
                "id": "CommandsShortcut",
                "properties": {
                    "suggested_key": {
                        "additionalProperties": {
                            "type": "string"
                        },
                        "annotations": [
                            {
                                "version_added": "140"
                            }
                        ],
                        "optional": true,
                        "properties": {
                            "default": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "optional": true
                            },
                            "linux": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "optional": true
                            },
                            "mac": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "optional": true
                            },
                            "windows": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "optional": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            }
        ]
