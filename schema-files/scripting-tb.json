            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/daily-mv3/scripting.compose.html#getregisteredscripts-filter"
                    }
                ],
                "async": "callback",
                "description": "Returns all registered compose scripts for this extension that match the given filter.",
                "name": "getRegisteredScripts",
                "parameters": [
                    {
                        "$ref": "ComposeScriptFilter",
                        "annotations": [],
                        "description": "An object to filter the extension's registered compose scripts.",
                        "name": "filter",
                        "optional": true
                    },
                    {
                        "annotations": [],
                        "description": "The resulting array contains the registered compose scripts.",
                        "name": "callback",
                        "parameters": [
                            {
                                "annotations": [],
                                "items": {
                                    "$ref": "ComposeScriptDetails"
                                },
                                "name": "scripts",
                                "type": "array"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "note": "Registered scripts will only be applied to newly opened message compose tabs. To apply the script to already open message compose tabs, manually inject your script by calling $(ref:scripting.executeScript) for each of the open <var>messageCompose</var> tabs."
                    },
                    {
                        "hint": "There is a known issue in the logging mechanism of compose scripts: All entries logged to the console appear twice."
                    },
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/daily-mv3/scripting.compose.html#registerscripts-scripts"
                    }
                ],
                "async": "callback",
                "description": "Registers one or more compose scripts for this extension, which should be injected into the message compose editor.",
                "name": "registerScripts",
                "parameters": [
                    {
                        "annotations": [],
                        "description": "Contains a list of compose scripts to be registered. If there are errors during script parsing/file validation, or if the IDs specified already exist, then no scripts are registered.",
                        "items": {
                            "$ref": "ComposeScriptDetails"
                        },
                        "name": "scripts",
                        "type": "array"
                    },
                    {
                        "annotations": [],
                        "description": "Invoked upon completion of the registration.",
                        "name": "callback",
                        "parameters": [],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/daily-mv3/scripting.compose.html#unregisterscripts-filter"
                    }
                ],
                "async": "callback",
                "description": "Unregisters one or more compose scripts for this extension.",
                "name": "unregisterScripts",
                "parameters": [
                    {
                        "$ref": "ComposeScriptFilter",
                        "annotations": [],
                        "description": "If specified, only unregisters compose scripts which match the filter. Otherwise, all of the extension's compose scripts are unregistered.",
                        "name": "filter",
                        "optional": true
                    },
                    {
                        "annotations": [],
                        "description": "Invoked upon completion of the unregistration.",
                        "name": "callback",
                        "parameters": [],
                        "type": "function"
                    }
                ],
                "type": "function"
            }
        ],
