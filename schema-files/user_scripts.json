[
    {
        "applicationVersion": "140.7.2esr",
        "namespace": "manifest",
        "types": [
            {
                "$extend": "OptionalOnlyPermission",
                "choices": [
                    {
                        "enum": [
                            "userScripts"
                        ],
                        "enums": {
                            "userScripts": {
                                "annotations": [
                                    {
                                        "version_added": true
                                    }
                                ]
                            }
                        },
                        "type": "string"
                    }
                ]
            },
            {
                "$extend": "WebExtensionManifest",
                "properties": {
                    "user_scripts": {
                        "additionalProperties": {
                            "$ref": "UnrecognizedProperty"
                        },
                        "annotations": [
                            {
                                "version_added": true
                            }
                        ],
                        "optional": true,
                        "properties": {
                            "api_script": {
                                "$ref": "manifest.ExtensionURL",
                                "optional": true
                            }
                        },
                        "type": "object"
                    }
                }
            }
        ]
    },
    {
        "annotations": [
            {
                "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/userScripts"
            },
            {
                "bcd": true,
                "note": "Available for use with Manifest V3 only."
            },
            {
                "bcd": true,
                "note": "An incompatible version of this API is available for Manifest V2. See <a href=\"https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/userScripts_legacy\">userScripts (Legacy)</a>."
            },
            {
                "version_added": "136"
            }
        ],
        "functions": [
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/userScripts/register"
                    },
                    {
                        "bcd": true,
                        "note": "An incompatible version of this function is available for Manifest V2. See <a href=\"https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/userScripts_legacy/register\">userScripts (Legacy)</a>."
                    },
                    {
                        "version_added": "136"
                    }
                ],
                "async": "callback",
                "description": "Register a user script programmatically given its $(ref:userScripts.UserScriptOptions), and resolves to an object with the unregister() function",
                "name": "register",
                "parameters": [
                    {
                        "$ref": "UserScriptOptions",
                        "name": "userScriptOptions"
                    },
                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "description": "An object that represents a user script registered programmatically",
                                "name": "legacyRegisteredUserScript",
                                "properties": {
                                    "unregister": {
                                        "async": true,
                                        "description": "Unregister a user script registered programmatically",
                                        "parameters": [],
                                        "type": "function"
                                    }
                                },
                                "type": "object"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "userScripts",
        "permissions": [
            "manifest:user_scripts",
            "userScripts"
        ],
        "types": [
            {
                "description": "Details of a user script",
                "id": "UserScriptOptions",
                "properties": {
                    "allFrames": {
                        "default": false,
                        "description": "If allFrames is <code>true</code>, implies that the JavaScript should be injected into all frames of current page. By default, it's <code>false</code> and is only injected into the top frame.",
                        "optional": true,
                        "type": "boolean"
                    },
                    "cookieStoreId": {
                        "choices": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1,
                                "type": "array"
                            },
                            {
                                "type": "string"
                            }
                        ],
                        "description": "limit the set of matched tabs to those that belong to the given cookie store id",
                        "optional": true
                    },
                    "excludeGlobs": {
                        "items": {
                            "type": "string"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "excludeMatches": {
                        "items": {
                            "$ref": "manifest.MatchPattern"
                        },
                        "minItems": 1,
                        "optional": true,
                        "type": "array"
                    },
                    "includeGlobs": {
                        "items": {
                            "type": "string"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "js": {
                        "description": "The list of JS files to inject",
                        "items": {
                            "$ref": "extensionTypes.ExtensionFileOrCode"
                        },
                        "minItems": 1,
                        "optional": false,
                        "type": "array"
                    },
                    "matchAboutBlank": {
                        "default": false,
                        "description": "If matchAboutBlank is true, then the code is also injected in about:blank and about:srcdoc frames if your extension has access to its parent document. Code cannot be inserted in top-level about:-frames. By default it is <code>false</code>.",
                        "optional": true,
                        "type": "boolean"
                    },
                    "matches": {
                        "items": {
                            "$ref": "manifest.MatchPattern"
                        },
                        "minItems": 1,
                        "optional": false,
                        "type": "array"
                    },
                    "runAt": {
                        "$ref": "extensionTypes.RunAt",
                        "default": "document_idle",
                        "description": "The soonest that the JavaScript will be injected into the tab. Defaults to \"document_idle\".",
                        "optional": true
                    },
                    "scriptMetadata": {
                        "$ref": "extensionTypes.PlainJSONValue",
                        "description": "An opaque user script metadata value",
                        "optional": true
                    }
                },
                "type": "object"
            }
        ]
    }
]